{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: pytest (all unit tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "tests/",
        "-v",
        "-m",
        "not integration"
      ]
    },
    {
      "name": "Debug: pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "${relativeFile}",
        "-v",
        "-m",
        "not integration"
      ]
    },
    {
      "name": "Debug: pytest (chunker)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "tests/test_chunker.py",
        "-v"
      ]
    },
    {
      "name": "Debug: pytest (embedder)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "tests/test_embedder.py",
        "-v",
        "-m",
        "not integration"
      ]
    },
    {
      "name": "Debug: pytest (embedder, live Ollama)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "LIVE_OLLAMA": "1"
      },
      "args": [
        "tests/test_embedder.py::test_live_ollama_nomic_embed_text",
        "-v",
        "-s"
      ]
    },
    {
      "name": "Debug: pytest (vector store)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "tests/test_vector_store.py",
        "-v",
        "-m",
        "not integration"
      ]
    },
    {
      "name": "Debug: pytest (vector store, live Qdrant)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "LIVE_QDRANT": "1"
      },
      "args": [
        "tests/test_vector_store.py::test_live_qdrant_docker",
        "-v",
        "-s"
      ]
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
